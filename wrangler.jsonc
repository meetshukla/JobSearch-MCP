// Hunt on Cloudflare's free plan: one Worker, one Durable Object (SQLite), static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hunt",
  "main": "worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/.well-known/*"]
  },
  "durable_objects": { "bindings": [{ "name": "HUNT", "class_name": "Hunt" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hunt"] }],
  // Wakes the collector if its alarm was ever lost.
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
  // Your own domain: npx wrangler deploy --domain jobs.example.com
}
